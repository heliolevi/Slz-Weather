MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/sao-luis-weather-watch?appName=Admin
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
SMS_DESTINATARIO_DEFESA_CIVIL=+5598900000000
# Opcional: URL real do webhook de alertas da Defesa Civil. Se vazio, o disparo é ignorado (sem tentativa de rede).
DEFESA_CIVIL_WEBHOOK_URL=
# Obrigatória para os endpoints /cron/* (ver CronController): gere um valor aleatório longo, ex.
# `openssl rand -hex 32`. Sem ela, /cron/* fica desabilitado (401 em qualquer chamada) por padrão.
# Na Vercel, defina a MESMA string em Project Settings -> Environment Variables com o nome
# CRON_SECRET — a Vercel injeta esse valor automaticamente no header Authorization das suas
# próprias Cron Jobs; para o workflow do GitHub Actions, salve o mesmo valor como um Secret do
# repositório (Settings -> Secrets and variables -> Actions) com o mesmo nome.
CRON_SECRET=
